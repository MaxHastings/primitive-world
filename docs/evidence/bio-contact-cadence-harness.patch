+#[test]
+#[ignore = "short, isolated copied-checkpoint biological-cadence funnel probe"]
+fn copied_checkpoint_biological_cadence_funnel() {
+    use std::path::PathBuf;
+    let receipt = PathBuf::from(std::env::var("PRIMITIVE_PROFILE_RECEIPT").unwrap());
+    let output = PathBuf::from(std::env::var("PRIMITIVE_PROFILE_OUTPUT").unwrap());
+    assert!(!output.exists());
+    let record: crate::experiments::SaveRecord =
+        serde_json::from_slice(&std::fs::read(&receipt).unwrap()).unwrap();
+    let (d, q) = super::tests::gpu();
+    let mut s = Simulation::new(&d, &q, record.seed);
+    s.load_game_checkpoint(
+        &q,
+        std::fs::File::open(receipt.parent().unwrap().join(&record.checkpoint)).unwrap(),
+        (record.seed, record.tick, record.living),
+        record.world,
+    )
+    .unwrap();
+    assert_eq!(s.tick, 0);
+    s.funnel_observer = Some(FunnelObserver::with_capacity(&d, &s, 50_000));
+    let mut rows = Vec::new();
+    for bio in (0..=3_000).step_by(300) {
+        if bio > 0 {
+            super::tests::step(&mut s, &d, &q, 300 / BIO_DT);
+        }
+        let m = s.metrics(&d, &q).unwrap();
+        let c = s.funnel_observer.as_ref().unwrap().counts(&d, &q);
+        rows.push(json!({"bio":bio,"living":m.living,"packets":m.packets,
+            "actions":m.action_ticks,"force_contacts":m.force_attempts,
+            "birth_gates":m.birth_gates,"events":m.events,
+            "compatible_packet_coexist_macro_steps":c[3],
+            "pre_fusion_packet_macro_steps":c[26],
+            "compatible_packet_proposal_macro_steps":c[27],
+            "viable_packet_proposal_macro_steps":c[28],
+            "packet_macro_steps_above_32_energy":c[29],
+            "packet_proposals_above_48_birth_energy":c[30]}));
+        if let Some(row) = rows.last_mut() {
+            row["production_decisions_observed"] = json!(c[31]);
+            row["production_decisions_with_any_sensed_entity"] = json!(c[32]);
+            row["production_decisions_with_near_sensed_entity"] = json!(c[33]);
+            row["packets_produced_with_near_sensed_entity"] = json!(c[34]);
+            row["organism_decisions_with_near_sensed_entity"] = json!(c[35]);
+            row["organism_decisions_with_any_sensed_entity"] = json!(c[36]);
+            row["production_with_organism_within_6_post_move"] = json!(c[37]);
+            row["production_with_organism_within_12_post_move"] = json!(c[38]);
+        }
+    }
+    std::fs::write(&output, serde_json::to_vec_pretty(&json!({
+        "bio_dt": BIO_DT,"receipt":receipt,"rows":rows,
+        "scope":"Read-only observer on an isolated copy. Packet proposal counts are packet-macro-step counts and may count both members. They do not equal distinct pairs. No live saves or wallpaper changed."
+    })).unwrap()).unwrap();
+}
